    "onboarding.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Focus Tool 37 bewegt den Fokus per Tastatur zwischen Fenstern. Dafür muss es sehen, wo die Fenster anderer Apps liegen, sie nach vorne holen und den Zeiger bewegen. macOS erlaubt das nur Apps, denen du Zugriff auf die Bedienungshilfen gegeben hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Focus Tool 37 moves focus between windows from the keyboard. To do that it has to see where other apps' windows are, bring them forward and move the pointer. macOS only allows this for apps you've given Accessibility access."
          }
        }
      }
    },
    "onboarding.step.done" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Focus Tool 37 legt sofort los, ohne Neustart. Dieses Fenster schließt sich von selbst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Focus Tool 37 starts working right away, no restart needed. This window closes by itself."
          }
        }
      }
    },
    "onboarding.step.enable" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
